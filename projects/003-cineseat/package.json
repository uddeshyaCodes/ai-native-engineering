{
  "name": "cineseat",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "db:migrate": "prisma migrate dev --name init",
    "db:seed": "node prisma/seed.mjs",
    "db:reset": "prisma migrate reset --force --skip-seed && npm run db:seed",
    "audit:a11y": "npx @axe-core/cli http://localhost:3000"
  },
  "dependencies": {
    "@ai-sdk/groq": "1.2.9",
    "@prisma/client": "6.19.3",
    "ai": "4.3.19",
    "next": "15.5.25",
    "next-auth": "5.0.0-beta.32",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/react": "4.13.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@types/jest": "29.5.14",
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
