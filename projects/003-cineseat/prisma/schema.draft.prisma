generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Showtime {
  id     String   @id @default(cuid())
  film   String
  time   DateTime
  screen Int
  seats  Seat[]
}

model Seat {
  id         String @id @default(cuid())
  showtimeId String
  row        String
  number     Int
  status     String @default("available") // <-- free text. Anything goes.

  showtime Showtime @relation(fields: [showtimeId], references: [id])

  @@index([showtimeId])
}
