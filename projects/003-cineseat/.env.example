# ---------------------------------------------------------------------------
# CineSeat environment variables
# Copy this file to .env.local and fill in what you have.
# EVERY variable here is optional for the classroom build - the app degrades
# gracefully when one is missing. That is Section D's "fallback behaviour"
# lesson, applied to our own config.
# ---------------------------------------------------------------------------

# --- Database (Section C) --------------------------------------------------
# SQLite file, created by `npm run db:migrate`. No server to install.
DATABASE_URL="file:./dev.db"

# --- Auth (Section C) ------------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET=""

# Leave these EMPTY to use the built-in "Demo sign-in" provider (no Google
# Cloud Console account needed). Fill them in to use real Google OAuth.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- ReelBot / Groq (Section D) --------------------------------------------
# Get a free key at https://console.groq.com/keys
# Leave EMPTY and ReelBot runs in offline mode: it still streams, still
# renders, still lets you demo the confirmation gate - it just replies from a
# canned script instead of a model.
GROQ_API_KEY=""

# Optional. llama-3.3-70b-versatile was shut down 2026-08-16.
# Check the current list: https://console.groq.com/docs/models
GROQ_MODEL="openai/gpt-oss-20b"
