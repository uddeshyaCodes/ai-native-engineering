# Shared configuration across part1, part2, and part3.
# Copy to .env  (cp .env.example .env). Nothing here is needed in mock mode.
# NEVER commit .env, and never copy it into a Docker image (Part 3).

# mock | openai | anthropic
LLM_PROVIDER=mock

# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# Any OpenAI-compatible endpoint works too (OpenRouter, Groq, a local server).
# Strict JSON-schema support varies by model, so try it before you rely on it.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Example for Groq:
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile

# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Generous on purpose: truncated JSON is unparseable JSON.
MAX_TOKENS=1500
TEMPERATURE=0.4

# Dev-mode switch. true => /v1/fit-report/preview exists (and, from Part 2,
# the model's scratchpad is returned). Leave unset in production.
# APP_DEBUG=true
