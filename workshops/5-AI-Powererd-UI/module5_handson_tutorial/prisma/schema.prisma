generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Order {
  id           String   @id @default(cuid())
  customerName String
  item         String
  status       String   // "pending" | "shipped" | "delivered" | "cancelled"
  createdAt    DateTime @default(now())
}
