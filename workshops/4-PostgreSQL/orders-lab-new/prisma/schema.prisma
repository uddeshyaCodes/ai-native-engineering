// prisma/schema.prisma
// This is the REVIEWED version — see README.md "Step 1 vs Step 3" for the
// AI-drafted version this was corrected from (Chapter 4 / Lab Step 1-2).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Auth models (NextAuth.js Prisma adapter, database sessions) ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  accounts Account[]
  sessions Session[]
  orders   Order[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Domain model: the lab's actual deliverable ---

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  CANCELLED
}

model Order {
  id        String      @id @default(cuid())
  userId    String
  // Decimal, not Float — keeps currency math exact (Chapter 4 / Lab Step 2 catch)
  total     Decimal     @db.Decimal(10, 2)
  status    OrderStatus @default(PENDING)
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id])

  // Without these two lines, every list-by-user or filter-by-status
  // query becomes a full table scan (Chapter 4 / Lab Step 2 catch)
  @@index([userId])
  @@index([status])
}
